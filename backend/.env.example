# Copy this template to PROJECT_ROOT/config/.env (not backend/.env).
# Empty storage overrides use project-root data/, backups/database/, logs/.
LIBRA_RUNTIME_DIR=
LIBRA_BACKUP_DIR=
LIBRA_LOG_DIR=
# Main Libra conversation engine: codex or claude.
# Restart the backend after changing either value.
LIBRA_LLM_PROVIDER=codex
# Disable all synchronous and background affect-model processing when false.
LIBRA_AFFECT_ENABLED=true
# Disable bedtime diary generation and retries when false.
LIBRA_DIARY_ENABLED=true
# Leave blank to use the selected CLI's default model.
# Examples: gpt-5.6-sol (Codex), sonnet or opus (Claude Code).
LIBRA_LLM_MODEL=
# Main chat calls may include memory and life context. Increase this on slower hosts.
LIBRA_CHAT_TIMEOUT_SECONDS=300

# Voice transcription (Groq Whisper)
GROQ_API_KEY=
WHISPER_MODEL=whisper-large-v3
WHISPER_LANG=zh
VOICE_HTTP_PROXY=http://127.0.0.1:7897

# Libra assistant voice (ElevenLabs text-to-speech)
ELEVENLABS_TTS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_STABILITY=0.5
ELEVENLABS_STYLE=0.4
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_LANGUAGE_CODE=zh
ELEVENLABS_TEXT_NORMALIZATION=auto
ELEVENLABS_SPEED=1.0

# Low-latency phone-call voice. Blank values inherit the message settings above.
ELEVENLABS_CALL_VOICE_ID=
ELEVENLABS_CALL_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_CALL_STABILITY=0.5
ELEVENLABS_CALL_STYLE=0.3
ELEVENLABS_CALL_SIMILARITY_BOOST=0.75
ELEVENLABS_CALL_LANGUAGE_CODE=zh
ELEVENLABS_CALL_TEXT_NORMALIZATION=auto
ELEVENLABS_CALL_SPEED=1.0

# Fast phone-call reply model (OpenAI-compatible API).
# API key/base URL fall back to LLM_* below when blank.
VOICE_CALL_LLM_API_KEY=
VOICE_CALL_LLM_BASE_URL=
VOICE_CALL_LLM_MODEL=deepseek-chat

# Voice emotion analysis (any OpenAI-compatible chat API)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Optional: keep Libra's Codex login separate from VS Code/Codex.
# Example: LIBRA_CODEX_HOME=C:\Users\YOUR_NAME\.codex-libra
# Leave blank to use the default Codex account on this computer.
LIBRA_CODEX_HOME=
